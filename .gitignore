*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node
node_modules/
npm-debug.log*

# Build / artifacts
dist/
build/
*.o
*.out
*.bin

# Compiled lab binaries (regenerate with `make`: vuln, vuln-hardened,
# vuln-canaryonly, vuln-fortifyonly, fuzz, …)
vuln
vuln-*
fuzz

# Security tool output
*.sarif
trivy-report.*
semgrep-report.*
sbom.json
sbom.xml
*.sig

# Secrets — never commit
.env
*.pem
*.key
secrets/

# Instructor-only — answer keys, CTF flags, exam keys (never publish)
instructor/

# libFuzzer crash artifacts
crash-*
.gstack/

# /codex skill session-continuity state (Codex thread ID for resume)
.context/

# Student submission uploads — never belongs in a public repo (PDPA)
labs/live-quiz/uploads/

# Internal-lab deployment material generated on an operator workstation/host.
# Peer configs contain WireGuard private keys; Terraform state can contain IDs,
# IP assignments, and rendered bootstrap data. None belongs in Git.
deploy/internal-labs/.env
deploy/internal-labs/secrets/
infra/aws-vpn-labs/terraform.tfvars
infra/aws-vpn-labs/*.auto.tfvars
infra/aws-vpn-labs/*.tfplan
infra/aws-vpn-labs/.terraform/
infra/aws-vpn-labs/generated-peers/
infra/aws-vpn-labs/operator-known-hosts
**/*.tfstate
**/*.tfstate.*
crash.log
crash.*.log
# Personal deployment artifacts and identities never enter source control.
deploy/personal-labs/generated/
deploy/personal-labs/.env
deploy/personal-labs/*.key
deploy/personal-labs/*.token
deploy/personal-labs/roster*.json
labs/live-quiz/learners.db*
