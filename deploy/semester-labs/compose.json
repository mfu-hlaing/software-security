{
  "name": "software-security-semester",
  "services": {
    "learning": {
      "init": true,
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 128,
      "cpus": "1.0",
      "mem_limit": "512m",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=16m,mode=1777"
      ],
      "build": {
        "context": "../..",
        "dockerfile": "deploy/internal-labs/images/learning.Dockerfile"
      },
      "environment": {
        "SECRET_KEY": "${SEMESTER_SECRET_KEY:?generate .env with setup.py}",
        "INVITE_CODE": "",
        "DB_PATH": "/data/semester.db",
        "UPLOAD_DIR": "/data/uploads",
        "COOKIE_SECURE": "1",
        "SITE_ORIGIN": "https://${SEMESTER_LEARN_HOST:-learn.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}",
        "SEMESTER_WEEK10_VULNERABLE_URL": "https://${SEMESTER_API_VULNERABLE_HOST:-api-vulnerable.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}",
        "SEMESTER_WEEK10_DEFENDED_URL": "https://${SEMESTER_API_DEFENDED_HOST:-api-defended.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}",
        "SEMESTER_WEEK14_VULNERABLE_URL": "https://${SEMESTER_AI_VULNERABLE_HOST:-ai-vulnerable.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}",
        "SEMESTER_WEEK14_DEFENDED_URL": "https://${SEMESTER_AI_DEFENDED_HOST:-ai-defended.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}",
        "SEMESTER_WEEK15_VULNERABLE_URL": "https://${SEMESTER_OPS_VULNERABLE_HOST:-ops-vulnerable.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}",
        "SEMESTER_WEEK15_DEFENDED_URL": "https://${SEMESTER_OPS_DEFENDED_HOST:-ops-defended.semester.localhost}:${SEMESTER_HTTPS_PORT:-9443}"
      },
      "volumes": [
        "learning_data:/data"
      ],
      "networks": [
        "learning"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/',timeout=2)"
        ],
        "interval": "20s",
        "timeout": "4s",
        "retries": 3,
        "start_period": "15s"
      }
    },
