# Copy to .env and replace every example value. Never use real student IDs as
# TEAM_*_ID; use opaque team aliases. The AWS cloud-init creates this file with
# random secrets locally on each lab host, outside Terraform state.
COMPOSE_PROFILES=all-teams
BIND_ADDRESS=127.0.0.1

LEARN_HOST=learn.pilot.labs.test
WEEK01_HOST=w1.pilot.labs.test
WEEK04_HOST=w4.pilot.labs.test
WEEK05_HOST=w5.pilot.labs.test
WEEK06_HOST=w6.pilot.labs.test
TEAM_1_HOST=project.team1.pilot.labs.test
TEAM_2_HOST=project.team2.pilot.labs.test

TEAM_1_ID=team-one-demo
TEAM_2_ID=team-two-demo

# Generate independently, for example: openssl rand -hex 32
LIVE_QUIZ_SECRET_KEY=replace-with-at-least-32-random-bytes
LIVE_QUIZ_INVITE_CODE=
TEAM_1_SALT=replace-with-independent-random-value
TEAM_2_SALT=replace-with-independent-random-value
FLAG_SQLI=FLAG{replace-this}
FLAG_CMDI=FLAG{replace-this}
FLAG_IDOR=FLAG{replace-this}
FLAG_JWT=FLAG{replace-this}
